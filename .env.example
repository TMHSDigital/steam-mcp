# Every setting steam-mcp reads, with defaults. See "Configuration" in README.md.
#
# The server does not load a .env file. Put the values you need in your MCP
# client's "env" block, export them in the shell that starts the server, or
# pass this file to Docker with `docker run --env-file .env ...`.
# Copy it to .env (gitignored) and never commit real keys.

# --- Keys ---
# Steam Web API key: https://steamcommunity.com/dev/apikey
# Leaderboard, partner, and write tools need a Steamworks publisher key with
# the server's IP allowlisted.
STEAM_API_KEY=
# Financial API Group key for steam_getSalesSummary / steam_getChangedSalesDates.
# Falls back to STEAM_API_KEY.
# STEAM_FINANCIAL_API_KEY=

# --- Tools ---
# Toolsets to load: store, community, publisher, mutations, sdk, assets, or all.
# Default: everything except mutations (live writes).
# STEAM_MCP_TOOLSETS=all
# 1 removes the mutations toolset even if STEAM_MCP_TOOLSETS lists it.
# STEAM_MCP_READ_ONLY=1

# --- Caching and logging ---
# Unset: per-endpoint TTLs (30s player count up to 1h schemas). 0 disables the
# cache. Any other number of seconds replaces every TTL.
# STEAM_MCP_CACHE_TTL=0
# 1 logs each Steam request (host, path, query keys, status, latency) to
# stderr. Never logs values.
# STEAM_MCP_DEBUG=1

# --- HTTP transport ---
# stdio (default) or http. Same as --transport.
# STEAM_MCP_TRANSPORT=http
# Bind address and port for HTTP mode. Same as --host / --port.
# HOST=127.0.0.1
# PORT=3000
# Host header values to accept (DNS-rebinding guard). * disables the check.
# STEAM_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# 1 lets the mutations toolset load in HTTP mode.
# STEAM_MCP_HTTP_ALLOW_WRITES=1

# --- Partner admin (separate process only: npx tsx src/partner/index.ts) ---
# Ignored by the default server.
# STEAM_PARTNER_ADMIN=1
# Path to a Netscape-format cookie jar file, never a cookie string.
# STEAM_PARTNER_COOKIES=
# Chromium user-data directory outside the repo, for the login helper.
# STEAM_PARTNER_PROFILE_DIR=
